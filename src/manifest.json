{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Wipe Ad",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Wipe Ad",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "ui/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "unlimitedStorage",
    "tabs",
    "webNavigation",
    "webRequest",
    "scripting",
    "alarms",
    "contextMenus",
    "cookies",
    "notifications"
  ],
  "optional_permissions": [
    "privacy",
    "contentSettings",
    "browsingData"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "js": [
        "content/main.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "resources/*",
        "ui/skip.html",
        "ui/focus.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "declarative_net_request": {
    "rule_resources": []
  },
  "commands": {
    "open-picker": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "__MSG_cmdPicker__"
    },
    "open-zapper": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "__MSG_cmdZapper__"
    },
    "toggle-site": {
      "description": "__MSG_cmdToggleSite__"
    }
  }
}
